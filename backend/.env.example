# Advanced Image Detection Configuration

# Core AI/ML Settings
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
YOLO_MAX_DETECTIONS=100
YOLO_DEVICE=cpu
YOLO_ENSEMBLE_ENABLED=false

# SAM (Segment Anything Model) Settings
SAM_MODEL_NAME=sam_vit_h_4b8939.pth
SAM_CONFIDENCE_THRESHOLD=0.7
SAM_DEVICE=cpu
SAM_ENABLED=false

# General AI Settings
MAX_IMAGE_SIZE=1920
ENABLE_GPU=false
BATCH_SIZE=1

# Advanced Preprocessing Settings
ENABLE_ADVANCED_PREPROCESSING=true
ANGLE_CORRECTION_ENABLED=true
LIGHTING_NORMALIZATION_ENABLED=true
IMAGE_ENHANCEMENT_ENABLED=true
MULTI_SCALE_ENABLED=false

# Quality Assurance Settings
MIN_CONFIDENCE_THRESHOLD=0.3
MAX_DETECTIONS_LIMIT=50

# Performance Settings
ENABLE_PERFORMANCE_MONITORING=true
LOG_DETAILED_METRICS=true
